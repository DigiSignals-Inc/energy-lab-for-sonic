# Secrets: never commit keys. Keep *.env.example files as templates.
*.env
!*.env.example
.copilot.env
.agent.env
*.key
*.pem
*.csr
*.srl
*_ed25519*
id_rsa*
id_ed25519*
known_hosts

# Runtime data, build output, caches
.run/
.selftest/
clab-*/
__pycache__/
*.pyc
.venv/
node_modules/
*.bak
.DS_Store

# Big binaries: link to the official downloads instead
*.bin
*.img

# Slides and recordings: keep them out of the repo
*.mp4
*.pptx

# Generated by run.sh / fabgen.py
build/
