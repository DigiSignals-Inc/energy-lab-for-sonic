# Settings read from the environment by app/, real-hardware/ and virtual-fabric/.
#
#   cp .env.example .env        # .env is git-ignored; never commit real values
#   set -a; . ./.env; set +a    # export them into your shell before running a script
#
# Uncommented lines hold the same default the code already uses, so loading this file
# unchanged changes nothing. Commented lines are optional, per-machine, or would
# override something else; uncomment and fill in the ones you need.
# No real keys or passwords belong in this file.

# ─── Command Center: app/app.py ──────────────────────────────────────────────
# Port the Command Center web UI and API listen on.
COPILOT_PORT=9300
# Address it listens on. Anyone who can reach it can drive the lab, so the default is this
# machine only (Mac and Windows still reach it through the Linux VM's port forwarding).
COPILOT_BIND=127.0.0.1
# Required if COPILOT_BIND is not 127.0.0.1 or localhost (IPv4 only): a long random string. Open the page once as
# http://<host>:<port>/?token=<it>. Or keep the default and use an SSH tunnel instead.
# COPILOT_TOKEN=
# Prometheus base URL the Command Center reads the live picture from.
PROM_URL=http://127.0.0.1:9090
# Path to the fabric.json from fabgen.py. Set it so app.py and the exporter read the same file.
# FABRIC_JSON=<repo>/build/fabric.json
# Path to configure-fabric.sh (default: next to FABRIC_JSON).
# CONFIGURE_SH=<repo>/build/configure-fabric.sh
# Path to fabgen.py used by POST /api/fabric/apply (no button in the page; see ADR-0003). Default: virtual-fabric/fabgen.py.
# FABGEN=<repo>/virtual-fabric/fabgen.py
# Path to rebuild-fabric.sh used by POST /api/fabric/apply. Default: virtual-fabric/rebuild-fabric.sh.
# REBUILD_CMD=<repo>/virtual-fabric/rebuild-fabric.sh
# Largest fabric (spines + leaves) this host may deploy; bigger sizes are preview-only.
DEPLOY_MAX_SWITCHES=8
# Bits/s above which a link counts as carrying traffic on the map.
FLOW_THRESHOLD_BPS=5000
# 1 shows GPU servers on the live map, 0 hides them.
GPU_ON_MAP=1
# Most concurrent Traffic Studio streams.
TRAFFIC_MAX_STREAMS=12
# File the app and the exporter share for the modelled GPU-cluster state.
# GPU_STATE_FILE=<repo>/.run/gpu_state.json
# Power-efficiency anomaly detector: EWMA smoothing factor.
ANOM_ALPHA=0.2
# Anomaly detector: how many standard deviations above baseline counts as an anomaly.
ANOM_K=3.0
# Anomaly detector: samples to collect before flagging anything.
ANOM_WARMUP=8
# Anomaly detector: ratio above baseline to flag when the variance is about zero.
ANOM_MIN_RATIO=1.6
# Anomaly detector: load floor in Gb/s (avoids dividing by zero).
ANOM_EPS_GBPS=1e-4
# Seconds between server-side snapshots of the fabric.
SNAPSHOT_PERIOD=2.0
# 1 enables the shared snapshot sampler, 0 disables it.
SNAPSHOT_ENABLED=1
# Seconds between slow snapshot refreshes.
SNAPSHOT_SLOW_PERIOD=15.0
# Longest a long-poll request waits for a new snapshot, in seconds.
SNAPSHOT_HOLD=25.0
# Stop slow refreshes after this many seconds with no reader.
SNAPSHOT_IDLE_S=90.0
# Most clients that may wait on the snapshot at once.
SNAPSHOT_MAX_WAITERS=48
# Hard ceiling, in seconds, on one liveness probe fan-out.
PROBE_BUDGET_S=16.0

# ─── AI assistant brain (app/app.py; can also live in the git-ignored .copilot.env) ───
# offline (rules, no network), openai (any OpenAI-compatible API) or azure-anthropic.
COPILOT_BRAIN=offline
# OpenAI-compatible base URL used when COPILOT_BRAIN=openai.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# API key for OPENAI_BASE_URL. Leave empty here; put the real key in your own .env.
OPENAI_API_KEY=
# Model name, or a comma-separated fallback chain tried in order (default llama-3.3-70b-versatile).
# OPENAI_MODEL=llama-3.3-70b-versatile
# Token budget per answer.
COPILOT_MAX_TOKENS=1500
# reasoning_effort sent to models that support it (dropped if the provider rejects it).
COPILOT_REASONING_EFFORT=low
# Retries on transient provider errors.
COPILOT_RETRIES=3
# Seconds to wait for the LLM per request.
COPILOT_TIMEOUT=40
# Base URL of an Azure-hosted Anthropic endpoint (the app appends /anthropic/v1/messages).
AZURE_ANTHROPIC_ENDPOINT=
# Bearer token for AZURE_ANTHROPIC_ENDPOINT. Leave empty here.
AZURE_ANTHROPIC_TOKEN=
# Model deployment name on that endpoint.
# AZURE_ANTHROPIC_DEPLOYMENT=<deployment-name>

# ─── Switch access: app/app.py, app/collector/fabric_exporter.py, real-hardware/gnmi-probe-hw.py ───
# Switch admin password. This is SONiC's public factory default; change it on real switches.
SW_PW=YourPaSsWoRd
# Username for gNMI logins to the switches.
GNMI_USER=admin
# Port of the switches' gNMI telemetry server (exporter).
GNMI_TARGET_PORT=8080
# Seconds before a gNMI read gives up (exporter).
GNMI_TIMEOUT=6
# Leaf whose gNMI reads the exporter logs.
GNMI_LEAF=leaf1

# ─── Exporter: app/collector/fabric_exporter.py ──────────────────────────────
# Lima VM name for exec mode "limactl" (also read by virtual-fabric/rebuild-fabric.sh).
LIMA_VM=sonic
# Seconds between polls of the fabric.
INTERVAL=8
# Load in bits/s that counts as full intensity for the energy model.
REF_BPS=5000000
# Modelled ASIC temperature at zero load, in °C.
TEMP_FLOOR=42
# Modelled ASIC temperature rise from zero to full load, in °C.
TEMP_SPAN=36
# Thermal smoothing factor. The exporter defaults to 0.12; run.sh passes 0.2.
# LAG=0.12
# Intensity above which modelled ECN/WRED/PFC congestion starts.
KNEE=0.65
# Modelled GPU utilisation with no training running.
GPU_IDLE_UTIL=0.05
# Modelled GPU utilisation during the all-reduce (comms) window.
GPU_COMMS_GATE=0.35
# Fraction of TDP an idle GPU still draws.
GPU_IDLE_FRAC=0.35
# Per-server power outside the GPUs (CPU, NVSwitch, NICs, fans), in watts.
GPU_SERVER_OVERHEAD_W=1500
# Smoothing of GPU utilisation (shapes the power sawtooth).
GPU_UTIL_LAG=0.45
# Ramp rate of training activity up and down.
GPU_ACT_LAG=0.25
# Coolant supply temperature from the CDU, in °C.
COOLANT_SETPOINT=32
# Coolant flow per rack, in litres per minute.
COOLANT_FLOW_LPM=42
# Constant in coolant temperature rise = heat_kw / flow * constant.
COOLANT_DT_CONST=35
# Smoothing of coolant return temperature (slow thermal node).
COOLANT_LAG=0.15
# GPU junction temperature above coolant at idle, in °C.
GPU_JUNC_BASE=16
# Extra junction temperature at full load, in °C.
GPU_JUNC_SPAN=42
# Smoothing of junction temperature (fast thermal node).
GPU_JUNC_LAG=0.5
# Junction temperature where thermal throttling starts, in °C.
GPU_THROTTLE_C=85
# Degrees over GPU_THROTTLE_C to reach the deepest throttle.
GPU_THROTTLE_BAND=12
# Lowest throttle factor (fraction of full speed).
GPU_THROTTLE_FLOOR=0.55
# Peak HBM bandwidth per GPU, in GB/s.
GPU_HBM_PEAK_GBPS=3350
# Peak NVLink bandwidth per GPU, in GB/s.
GPU_NVLINK_PEAK_GBPS=900

# ─── Fabric size: ./run.sh virtual|preview ───────────────────────────────────
# Numbers on the command line win. Default: 2 2 1.
# SPINES=2
# LEAVES=2
# HOSTS_PER_LEAF=1
# containerlab lab name (default lab). Not NAME: WSL sets NAME to the PC's name.
# LAB_NAME=lab

# ─── run.sh ──────────────────────────────────────────────────────────────────
# Seconds to wait for every switch to boot before giving up.
# BOOT_TIMEOUT=1200
# 1 starts even when the memory check says there isn't enough.
# FORCE=1
# SONiC release branch for the switches. The first run downloads the newest successful
# official build of this branch from SONiC's build pipeline and tags it docker-sonic-vs:<branch>.
# ./run.sh status shows which build you have. Default 202605; 202511 also works. master is
# untested with this lab (it has bgpcfgd/lldpd changes that 202605 does not).
# LAB_SONIC_BRANCH=202605
# 1 checks for a newer build of that branch and downloads it if there is one. Use it once, on
# the command line (LAB_SONIC_REFRESH=1 ./run.sh virtual), not here: here it checks on every run.
# LAB_SONIC_REFRESH=1
# Your own switch image instead (one Docker already has, or can pull). run.sh then downloads
# nothing. Also use it to keep a build you have tested: docker tag docker-sonic-vs:202605 my-sonic:tested
# If its syncd lacks libasan8 (as 202605 builds do), run.sh adds it and retags the image, so
# give a name:tag, not an image id or digest.
# LAB_SONIC_IMAGE=my-sonic:tested
# macOS only: the Linux VM run.sh creates. CPUs and memory (GB) apply when the VM is
# created. To change them later, run ./run.sh delete-vm, then ./run.sh virtual again.
# LAB_VM=energy-lab-for-sonic
# LAB_VM_CPUS=4
# LAB_VM_MEMORY=8

# ─── Real-hardware bench: real-hardware/bench/ ───────────────────────────────
# SSH destination of switch A (user@host or a ~/.ssh/config alias; default: alias "swa").
# gNMI connects to the host part, so use an IP or resolvable name if you want gNMI.
# BENCH_SWA=admin@<switch-a-ip>
# SSH destination of switch B (default: alias "swb").
# BENCH_SWB=admin@<switch-b-ip>
# SSH destination of traffic PC 1, the receiver (default: alias "pc1").
# BENCH_PC1=sonic@<pc1-ip>
# SSH destination of traffic PC 2, the sender (default: alias "pc2"; also used by setup-pc2-permanent.sh).
# BENCH_PC2=sonic@<pc2-ip>
# gNMI port on both bench switches.
BENCH_GNMI_PORT=8080
# Address the bench dashboard listens on. Default 127.0.0.1 (this machine only). The
# dashboard has no login and its buttons start traffic, so open it wider (0.0.0.0)
# only on a closed lab network.
# BENCH_BIND=127.0.0.1
# Extra address to print at dashboard start-up, for example a VPN address. Empty prints none.
BENCH_ADVERTISE_HOST=
# Login user on the traffic PCs for bringup-pc2.sh (PC-SETUP.md creates "sonic").
BENCH_PC_USER=sonic
# Static management address setup-pc2-permanent.sh writes into PC 2's netplan (required there).
# BENCH_PC2_MGMT_CIDR=<pc2-ip>/24
# Default gateway of the management LAN for that netplan (required there).
# BENCH_MGMT_GATEWAY=<gateway-ip>
# Data-path address setup-pc2-permanent.sh gives PC 2's 100G port. The default is from the
# earlier back-to-back setup; on the switch bench use the subnet of PC 1 (10.100.1.1).
# BENCH_PC2_DATA_CIDR=10.100.0.2/24

# ─── Bench AI agent: real-hardware/bench/agent.py ────────────────────────────
# These override real-hardware/bench/.agent.env (git-ignored), so leave them commented
# out if you use that file. Even an empty value would override it.
# Provider: openai-compatible (default) or azure-openai.
# AGENT_PROVIDER=openai-compatible
# Base URL: an OpenAI-compatible API (default https://api.openai.com/v1) or https://<your-resource>.openai.azure.com
# AGENT_BASE_URL=https://api.openai.com/v1
# API key for AGENT_BASE_URL.
# AGENT_API_KEY=<your-api-key>
# Model name, or a comma-separated fallback chain (openai-compatible only).
# AGENT_MODEL=<model-name>
# Model deployment name (azure-openai only).
# AGENT_DEPLOYMENT=<deployment-name>
# API version (azure-openai only).
# AGENT_API_VERSION=2024-10-21
